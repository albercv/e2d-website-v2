# =============================================================================
# .env.example — Evolve2Digital website
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Agent backend (DeepSeek + RAG over pgvector)
# -----------------------------------------------------------------------------

# Postgres connection string consumed by lib/db/client.ts and scripts/db-migrate.ts.
# Host/port must match the docker-compose service (loopback 127.0.0.1:5436).
DATABASE_URL=postgres://e2d:<set-by-deploy>@127.0.0.1:5436/e2d_ai

# Credentials baked into the pgvector container on first boot.
# docker-compose.yml reads these to seed POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
E2D_DB_USER=e2d
E2D_DB_PASSWORD=<set-by-deploy>
E2D_DB_NAME=e2d_ai

# DeepSeek LLM — chat completions and (optionally) embeddings.
DEEPSEEK_API_KEY=sk-deepseek-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Embeddings provider. If empty, falls back to DeepSeek; otherwise OpenAI-compatible.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=text-embedding-3-small

# RAG tuning knobs (consumed by the rag worktree).
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.72
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=64

# Apollo.io lead sync (consumed by the apollo sync worker and the explicit
# lead capture form in /api/chat/lead).
APOLLO_API_KEY=
APOLLO_SYNC_ENABLED=false

# Lead capture (consumed by lib/email/resend-client.ts and lib/leads/lead-service.ts)
# Resend transactional email. Sender domain must be verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@evolve2digital.com
# Inbox that receives the consultation email when a visitor submits the chat form.
ADMIN_EMAIL=alberto.carrasco@evolve2digital.com

# -----------------------------------------------------------------------------
# Contact
# -----------------------------------------------------------------------------

# Phone number in international format, digits only (no +, no spaces).
# Used by WhatsApp click-to-chat links across the site. If empty, all
# WhatsApp CTAs are hidden site-wide. Email contact is unaffected.
NEXT_PUBLIC_WHATSAPP_NUMBER=34605497639
